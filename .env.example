# === Choose ONE provider ===
# OpenRouter (OpenAI-compatible, cheaper, many models)
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=openai/gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# OpenAI (official)
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=  # leave unset for official OpenAI

# Source of the CV. Use ONE of these.
# 1. Local PDF, relative to AI_Chatbot/ or absolute.
CV_PATH="./Abolore_Sanni_CV.pdf"
# 2. Or fetch it from the portfolio backend (recommended in production).
# CV_URL=http://localhost:8000/profile/cv/view

# Optional extra knowledge (project write-ups, FAQs, services).
# KNOWLEDGE_FILE="./knowledge/about.md"
# KNOWLEDGE_DIR="./knowledge"

# API
PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://portfolio-eta-flax-91.vercel.app

# Optional: protects POST /reload. Leave blank to disable the endpoint.
RELOAD_TOKEN=
